# Shared git settings, loaded from ~/.config/git/config.
# user.name / user.email are deliberately NOT set here: they live in ~/.gitconfig, which git
# reads after this file, so the identity set there always wins.

[core]
	pager = less -FRX
	whitespace = trailing-space,space-before-tab
	autocrlf = input

[init]
	defaultBranch = main

[pull]
	ff = only

[push]
	default = simple
	autoSetupRemote = true

[fetch]
	prune = true

[rebase]
	autoStash = true
	autoSquash = true

[merge]
	conflictStyle = diff3

[diff]
	algorithm = histogram
	colorMoved = default

[rerere]
	enabled = true

[branch]
	sort = -committerdate

[color]
	ui = auto

[alias]
	st = status -sb
	co = checkout
	sw = switch
	br = branch -vv
	cm = commit -m
	ca = commit --amend --no-edit
	unstage = restore --staged
	undo = reset --soft HEAD~1
	lg = log --graph --pretty=format:'%C(auto)%h%d %s %C(dim)%an, %ar' -20
	last = log -1 --stat
	root = rev-parse --show-toplevel
	prune-merged = "!git branch --merged | grep -vE '^\\*|^\\s*(main|master|develop)$' | xargs -r git branch -d"
